  "reader_facing_definitions": {
    "task_cell_summary.csv": {
      "aggregation": "mean and sample SD (ddof=1) across the requested complete training seeds 3072,3073,3074; no pooling across factorial cells",
      "checkpoint_independence": "cells are not independent replicates",
      "columns": {
        "clean_success_mean": "mean of per-training-seed clean planning success means (%)",
        "clean_success_sd": "sample SD of those per-training-seed clean success means (%)",
        "ir_pass_count": "count of contributing training seeds whose fixed IR-only decision passes",
        "joint_pass_count": "count of contributing training seeds whose fixed IR-and-SR decision passes",
        "n_training_seeds": "number of complete training-seed rows contributing to the cell",
        "natural_sr_veto_count": "count of contributing training seeds whose IR passes while SR fails; IR pass count minus joint pass count",
        "relative_ir_mean": "mean of per-training-seed relative IR values",
        "relative_ir_sd": "sample SD of per-training-seed relative IR values",
        "retention_pp_mean": "mean of stress minus clean success (percentage points) across training seeds",
        "retention_pp_sd": "sample SD of per-training-seed stress minus clean success (percentage points)",
        "sr_mean": "mean of per-training-seed SR values",
        "sr_sd": "sample SD of per-training-seed SR values",
        "stress_success_mean": "mean of per-training-seed stress planning success means (%)",
        "stress_success_sd": "sample SD of those per-training-seed stress success means (%)"
